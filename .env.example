# Copy to .env and fill in local values. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greencorridor
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/greencorridor?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SERVER_PORT=8080

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=greencorridor
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
